# Anthropic API raktas — AI patarimams /eile puslapyje (penktadienio plano auditas).
# 1. Nukopijuokite šį failą į .env.local
# 2. Įklijuokite savo raktą iš https://console.anthropic.com/settings/keys
# 3. Tikrą raktą NIEKADA nekomituokite į git
ANTHROPIC_API_KEY=sk-ant-...
# Modelis /eile AI auditui (numatytas claude-sonnet-5; senas claude-3-5-sonnet nebepalaikomas)
# ANTHROPIC_MODEL=claude-sonnet-5
